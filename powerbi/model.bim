            "summarizeBy": "sum"
          },
          {
            "name": "Workload_Balance_Index",
            "dataType": "double",
            "sourceColumn": "Workload_Balance_Index",
            "summarizeBy": "sum"
          },
          {
            "name": "Balance_Status",
