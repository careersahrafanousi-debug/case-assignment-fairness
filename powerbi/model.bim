{
  "name": "case-assignment-fairness",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "headline",
        "columns": [
          {
            "name": "total_cases",
            "dataType": "int64",
            "sourceColumn": "total_cases",
            "summarizeBy": "sum"
          },
          {
            "name": "resolved",
            "dataType": "int64",
            "sourceColumn": "resolved",
            "summarizeBy": "sum"
          },
          {
            "name": "open_cases",
            "dataType": "int64",
            "sourceColumn": "open_cases",
            "summarizeBy": "sum"
          },
          {
            "name": "sla_pct",
            "dataType": "double",
            "sourceColumn": "sla_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "accuracy_pct",
            "dataType": "double",
            "sourceColumn": "accuracy_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "reopen_pct",
            "dataType": "double",
            "sourceColumn": "reopen_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "avg_hours",
            "dataType": "double",
            "sourceColumn": "avg_hours",
            "summarizeBy": "sum"
          },
          {
            "name": "breach_hours",
            "dataType": "double",
            "sourceColumn": "breach_hours",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "headline",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Csv.Document(File.Contents(ExtractFolder & \"\\headline.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])"
            }
          }
        ],
        "measures": [
          {
            "name": "Cases",
            "expression": "SELECTEDVALUE ( 'headline'[total_cases] )",
            "formatString": "#,0",
            "description": "Cases from the headline query extract."
          },
          {
            "name": "SLA compliance",
            "expression": "SELECTEDVALUE ( 'headline'[sla_pct] )",
            "formatString": "0.00\"%\"",
            "description": "Flat 61\u201364% for six months"
          },
          {
            "name": "Assignment accuracy",
            "expression": "SELECTEDVALUE ( 'headline'[accuracy_pct] )",
            "formatString": "0.00\"%\"",
            "description": "26.9% reassigned at least once"
          },
          {
            "name": "Reopen rate",
            "expression": "SELECTEDVALUE ( 'headline'[reopen_pct] )",
            "formatString": "0.00\"%\"",
            "description": "12.15% once reassigned"
          },
          {
            "name": "Avg resolution",
            "expression": "SELECTEDVALUE ( 'headline'[avg_hours] )",
            "formatString": "#,0.0\"h\"",
            "description": "Median 43.0h"
          },
          {
            "name": "Total breach hours",
            "expression": "SELECTEDVALUE ( 'headline'[breach_hours] )",
            "formatString": "#,0.0\"h\"",
            "description": "41% from one case type"
          },
          {
            "name": "Open cases",
            "expression": "SELECTEDVALUE ( 'headline'[open_cases] )",
            "formatString": "#,0",
            "description": "20 already past target"
          }
        ]
      },
      {
        "name": "dq",
        "columns": [
          {
            "name": "exceptions",
            "dataType": "int64",
            "sourceColumn": "exceptions",
            "summarizeBy": "sum"
          },
          {
            "name": "excluded",
            "dataType": "int64",
            "sourceColumn": "excluded",
            "summarizeBy": "sum"
          },
          {
            "name": "dq_score",
            "dataType": "double",
            "sourceColumn": "dq_score",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "dq",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Csv.Document(File.Contents(ExtractFolder & \"\\dq.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])"
            }
          }
        ],
        "measures": [
          {
            "name": "Data quality score",
            "expression": "SELECTEDVALUE ( 'dq'[dq_score] )",
            "formatString": "0.00\"%\"",
            "description": "92 records excluded and logged"
          }
        ]
      },
      {
        "name": "by_case_type",
        "columns": [
          {
            "name": "Case_Type",
            "dataType": "string",
            "sourceColumn": "Case_Type",
            "summarizeBy": "none"
          },
          {
            "name": "target_hours",
            "dataType": "int64",
            "sourceColumn": "target_hours",
            "summarizeBy": "sum"
          },
          {
            "name": "cases",
            "dataType": "int64",
            "sourceColumn": "cases",
            "summarizeBy": "sum"
          },
          {
            "name": "sla_pct",
            "dataType": "double",
            "sourceColumn": "sla_pct",
            "summarizeBy": "sum"
          },
          {
            "name": "avg_hours",
            "dataType": "double",
            "sourceColumn": "avg_hours",
            "summarizeBy": "sum"
          },
          {
            "name": "breach_hours",
            "dataType": "double",
            "sourceColumn": "breach_hours",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "by_case_type",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Csv.Document(File.Contents(ExtractFolder & \"\\by_case_type.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])"
            }
          }
        ],
        "measures": [
          {
            "name": "SLA compliance % (by_case_type)",
            "expression": "AVERAGE ( 'by_case_type'[sla_pct] )",
            "formatString": "#,0.00",
            "description": "SLA compliance % for the 'SLA compliance by case type, against its own target' visual."
          },
          {
            "name": "Breach hours (by_case_type)",
            "expression": "SUM ( 'by_case_type'[breach_hours] )",
            "formatString": "#,0.00",
            "description": "Breach hours for the 'Where the lateness actually is' visual."
          },
          {
            "name": "Avg resolution hours (by_case_type)",
            "expression": "AVERAGE ( 'by_case_type'[avg_hours] )",
            "formatString": "#,0.00",
            "description": "Avg resolution hours for the 'Average resolution time vs the published target' visual."
          },
          {
            "name": "SLA target hours (by_case_type)",
            "expression": "SUM ( 'by_case_type'[target_hours] )",
            "formatString": "#,0.00",
            "description": "SLA target hours for the 'Average resolution time vs the published target' visual."
          }
        ]
      },
      {
        "name": "teams",
        "columns": [
          {
            "name": "Team_ID",
            "dataType": "string",
            "sourceColumn": "Team_ID",
            "summarizeBy": "none"
          },
          {
