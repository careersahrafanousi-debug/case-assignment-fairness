            "formatString": "#,0.00",
            "description": "Assignment accuracy % for the 'Routing accuracy by method' visual."
          },
          {
            "name": "Reopen % (routing)",
            "expression": "AVERAGE ( 'routing'[reopen_pct] )",
            "formatString": "#,0.00",
            "description": "Reopen % for the 'Routing accuracy by method' visual."
          },
          {
            "name": "Assignment lag (hours) (routing)",
            "expression": "SUM ( 'routing'[lag_hours] )",
            "formatString": "#,0.00",
            "description": "Assignment lag (hours) for the 'Routing accuracy by method' visual."
          }
        ]
      },
      {
