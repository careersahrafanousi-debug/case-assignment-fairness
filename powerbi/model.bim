            "sourceColumn": "Balance_Status",
            "summarizeBy": "none"
          },
          {
            "name": "SLA_Compliance_Pct",
            "dataType": "double",
            "sourceColumn": "SLA_Compliance_Pct",
            "summarizeBy": "sum"
          },
          {
            "name": "Assignment_Accuracy_Pct",
            "dataType": "double",
            "sourceColumn": "Assignment_Accuracy_Pct",
            "summarizeBy": "sum"
          },
          {
            "name": "Median_Resolution_Hours",
            "dataType": "double",
            "sourceColumn": "Median_Resolution_Hours",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "teams",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "Csv.Document(File.Contents(ExtractFolder & \"\\teams.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv])"
            }
          }
        ]
      },
      {
        "name": "routing",
        "columns": [
          {
            "name": "Routing_Method",
            "dataType": "string",
            "sourceColumn": "Routing_Method",
            "summarizeBy": "none"
          },
          {
            "name": "cases",
