// DAX measures - Case Assignment Fairness and SLA Control Tower
// Generated by src/build_bi_assets.py from dashboard/dashboard_config.json.
// Paste into Power BI Desktop, or open powerbi/model.bim in Tabular Editor.

// Cases from the headline query extract.
Cases =
    SELECTEDVALUE ( 'headline'[total_cases] )
// format: #,0

// Flat 61–64% for six months
SLA compliance =
    SELECTEDVALUE ( 'headline'[sla_pct] )
// format: 0.00"%"

// 26.9% reassigned at least once
Assignment accuracy =
    SELECTEDVALUE ( 'headline'[accuracy_pct] )
// format: 0.00"%"

// 12.15% once reassigned
Reopen rate =
    SELECTEDVALUE ( 'headline'[reopen_pct] )
// format: 0.00"%"

// Median 43.0h
Avg resolution =
    SELECTEDVALUE ( 'headline'[avg_hours] )
// format: #,0.0"h"

// 41% from one case type
Total breach hours =
    SELECTEDVALUE ( 'headline'[breach_hours] )
// format: #,0.0"h"

// 20 already past target
Open cases =
    SELECTEDVALUE ( 'headline'[open_cases] )
// format: #,0

// 92 records excluded and logged
Data quality score =
    SELECTEDVALUE ( 'dq'[dq_score] )
// format: 0.00"%"

// SLA compliance % for the 'SLA compliance by case type, against its own target' visual.
SLA compliance % (by_case_type) =
    AVERAGE ( 'by_case_type'[sla_pct] )
// format: #,0.00

// Breach hours for the 'Where the lateness actually is' visual.
Breach hours (by_case_type) =
    SUM ( 'by_case_type'[breach_hours] )
// format: #,0.00

// Avg resolution hours for the 'Average resolution time vs the published target' visual.
Avg resolution hours (by_case_type) =
    AVERAGE ( 'by_case_type'[avg_hours] )
// format: #,0.00

// SLA target hours for the 'Average resolution time vs the published target' visual.
SLA target hours (by_case_type) =
    SUM ( 'by_case_type'[target_hours] )
// format: #,0.00

// Assignment accuracy % for the 'Routing accuracy by method' visual.
Assignment accuracy % (routing) =
    AVERAGE ( 'routing'[accuracy_pct] )
// format: #,0.00

// Reopen % for the 'Routing accuracy by method' visual.
Reopen % (routing) =
    AVERAGE ( 'routing'[reopen_pct] )
// format: #,0.00

// Assignment lag (hours) for the 'Routing accuracy by method' visual.
Assignment lag (hours) (routing) =
    SUM ( 'routing'[lag_hours] )
// format: #,0.00

// Cases for the 'What a reassignment costs' visual.
Cases (reassign_cost) =
    SUM ( 'reassign_cost'[cases] )
// format: #,0.00

// SLA compliance % for the 'What a reassignment costs' visual.
SLA compliance % (reassign_cost) =
    AVERAGE ( 'reassign_cost'[sla_pct] )
// format: #,0.00

// Reopen % for the 'What a reassignment costs' visual.
Reopen % (reassign_cost) =
    AVERAGE ( 'reassign_cost'[reopen_pct] )
// format: #,0.00

// SLA compliance % for the 'Does the complexity score predict anything?' visual.
SLA compliance % (complexity) =
    AVERAGE ( 'complexity'[sla_pct] )
// format: #,0.00

// Reassigned at least once % for the 'Does the complexity score predict anything?' visual.
Reassigned at least once % (complexity) =
    AVERAGE ( 'complexity'[reassigned_pct] )
// format: #,0.00

// Days of queued work for the 'Backlog days of work' visual.
Days of queued work (backlog) =
    SUM ( 'backlog'[backlog_days] )
// format: #,0.00

// Cases for the 'Root cause of resolved cases' visual.
Cases (root_cause) =
    SUM ( 'root_cause'[cases] )
// format: #,0.00

// SLA compliance % for the 'Monthly trend' visual.
SLA compliance % (monthly) =
    AVERAGE ( 'monthly'[sla_pct] )
// format: #,0.00

// Assignment accuracy % for the 'Monthly trend' visual.
Assignment accuracy % (monthly) =
    AVERAGE ( 'monthly'[accuracy_pct] )
// format: #,0.00

// SLA compliance % for the 'Tenure effect — real but small' visual.
SLA compliance % (tenure) =
    AVERAGE ( 'tenure'[sla_pct] )
// format: #,0.00

// SLA compliance % for the 'Segment equity — a null finding, reported anyway' visual.
SLA compliance % (segment) =
    AVERAGE ( 'segment'[sla_pct] )
// format: #,0.00
